{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "status": 307,
      "headers": {
        "Location": "/ar"
      },
      "src": "/"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_fonts/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_fonts(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/fr/zakah",
      "dest": "/fr/zakah"
    },
    {
      "src": "/fr/settings",
      "dest": "/fr/settings"
    },
    {
      "src": "/fr/sale",
      "dest": "/fr/sale"
    },
    {
      "src": "/fr/intro",
      "dest": "/fr/intro"
    },
    {
      "src": "/fr/buy",
      "dest": "/fr/buy"
    },
    {
      "src": "/fr/about",
      "dest": "/fr/about"
    },
    {
      "src": "/fr",
      "dest": "/fr"
    },
    {
      "src": "/es/zakah",
      "dest": "/es/zakah"
    },
    {
      "src": "/es/settings",
      "dest": "/es/settings"
    },
    {
      "src": "/es/sale",
      "dest": "/es/sale"
    },
    {
      "src": "/es/intro",
      "dest": "/es/intro"
    },
    {
      "src": "/es/buy",
      "dest": "/es/buy"
    },
    {
      "src": "/es/about",
      "dest": "/es/about"
    },
    {
      "src": "/es",
      "dest": "/es"
    },
    {
      "src": "/en/zakah",
      "dest": "/en/zakah"
    },
    {
      "src": "/en/settings",
      "dest": "/en/settings"
    },
    {
      "src": "/en/sale",
      "dest": "/en/sale"
    },
    {
      "src": "/en/intro",
      "dest": "/en/intro"
    },
    {
      "src": "/en/buy",
      "dest": "/en/buy"
    },
    {
      "src": "/en/about",
      "dest": "/en/about"
    },
    {
      "src": "/en",
      "dest": "/en"
    },
    {
      "src": "/ar/zakah",
      "dest": "/ar/zakah"
    },
    {
      "src": "/ar/settings",
      "dest": "/ar/settings"
    },
    {
      "src": "/ar/sale",
      "dest": "/ar/sale"
    },
    {
      "src": "/ar/intro",
      "dest": "/ar/intro"
    },
    {
      "src": "/ar/buy",
      "dest": "/ar/buy"
    },
    {
      "src": "/ar/about",
      "dest": "/ar/about"
    },
    {
      "src": "/ar",
      "dest": "/ar"
    },
    {
      "src": "/api/gold",
      "dest": "/api/gold"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/api/_nuxt_icon/(?<collection>[^/]+)",
      "dest": "/api/_nuxt_icon/[collection]"
    },
    {
      "src": "/_i18n/(?<hash>[^/]+)/(?<locale>[^/]+)/messages.json",
      "dest": "/_i18n/[hash]/[locale]/messages.json"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
